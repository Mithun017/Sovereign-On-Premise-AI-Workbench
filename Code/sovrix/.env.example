# ==========================================
# SOVRIX - Sovereign On-Premise AI Workbench
# Environment Configuration (.env)
# ==========================================

# Air-Gap Enforcement Flags
AIR_GAPPED_MODE=true
ALLOW_EXTERNAL_CALLS=false

# Database Configuration
DATABASE_URL=sqlite:///sovrix_enterprise.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://sovrix_admin:sovrix_defense_secure_password_2026@localhost:5432/sovrix_db

REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET=sovrix-sovereign-secure-key-2026-industrial-defense
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local Model Endpoints (Air-Gapped)
OLLAMA_ENDPOINT=http://127.0.0.1:11434
VLLM_ENDPOINT=http://127.0.0.1:8000/v1
LLAMACPP_ENDPOINT=http://127.0.0.1:8080

# Storage Paths
UPLOAD_DIRECTORY=./uploads
OUTPUT_DIRECTORY=./generated_deliverables

# Sandbox Resource Bounds
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MAX_MEMORY_MB=512
